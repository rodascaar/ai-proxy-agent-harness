# Upstream OpenAI-compatible (Ollama, LM Studio, llama.cpp, vLLM, DeepSeek...)
UPSTREAM_BASE_URL=https://api.deepseek.com
UPSTREAM_API_KEY=
UPSTREAM_MODEL=deepseek-v4-flash

# Límites del motor de descomposición atómica
MAX_DECOMPOSITION_DEPTH=3
MAX_TOOL_ROUNDS_PER_PHASE=25

# Dirección del proxy
PROXY_HOST=127.0.0.1
PROXY_PORT=8000

# Timeout de cada llamada al upstream
REQUEST_TIMEOUT_SECONDS=120s

# Sesiones de pausa/reanudación (persistidas como notas markdown)
SESSION_TTL_SECONDS=30m
MAX_SESSIONS=200
SESSIONS_DIR=.sessions

# Observabilidad
EXPOSE_REASONING_CONTENT=true
LOG_LEVEL=info