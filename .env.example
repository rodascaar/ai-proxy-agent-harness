# Upstream OpenAI-compatible. La URL es la RAÍZ del API (incluye el prefijo de
# versión cuando existe). Sirve cualquiera de estos:
#   LM Studio:  http://127.0.0.1:1234/v1
#   Ollama:     http://127.0.0.1:11434/v1
#   llama.cpp:  http://127.0.0.1:8080/v1
#   Remoto:     https://api.tu-proveedor.com/v1
UPSTREAM_BASE_URL=http://127.0.0.1:1234/v1
UPSTREAM_API_KEY=
# Modelo(s) por defecto, separados por coma (un solo servidor con varios
# modelos cargados). El primero es el modelo por defecto del chat.
UPSTREAM_MODEL=qwen2.5:7b

# Multi-upstream (opcional): varios upstreams, locales o remotos, para el
# debate multi-modelo. Si defines al menos UPSTREAM_1_BASE_URL, se usan estos
# en vez del legado. MODELS es una lista separada por comas de los modelos que
# expone cada upstream. La API key usa formato bearer simple (sin AWS/Azure).
# La URL es la raíz del API (p. ej. .../v1 para OpenAI-compatible, o
# .../v1beta/openai para Gemini).
#
# No hace falta conocer los nombres exactos: en la Web UI usá el botón
# "Detectar" de cada upstream para traer los modelos reales del servidor.
# UPSTREAM_1_BASE_URL=http://127.0.0.1:11434/v1
# UPSTREAM_1_MODELS=qwen2.5:7b,llama3.2:3b
# UPSTREAM_1_API_KEY=
# UPSTREAM_2_BASE_URL=https://api.openai.com/v1
# UPSTREAM_2_MODELS=gpt-4o-mini
# UPSTREAM_2_API_KEY=sk-...
# UPSTREAM_3_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# UPSTREAM_3_MODELS=gemini-2.0-flash
# UPSTREAM_3_API_KEY=...

# Debate (speculum): crítica y refinamiento de los resultados atómicos.
# Con un solo modelo, ese toma ambos roles; con 2-3 modelos, debaten entre sí.
DEBATE_ENABLED=false
DEBATE_ROUNDS=2

# Límites del motor de descomposición atómica
MAX_DECOMPOSITION_DEPTH=3
MAX_TOOL_ROUNDS_PER_PHASE=25

# Control de muestreo del modelo. 0 = greedy (determinista), valores altos =
# más variación. Los modelos locales chicos se benefician de valores bajos
# para evitar respuestas fuera de tema. La descomposición usa siempre 0.2.
TEMPERATURE=0.3

# Dirección del proxy
PROXY_HOST=127.0.0.1
PROXY_PORT=8000

# Timeout de cada llamada al upstream
REQUEST_TIMEOUT_SECONDS=120s

# Sesiones de pausa/reanudación (persistidas como notas markdown)
SESSION_TTL_SECONDS=30m
MAX_SESSIONS=200
SESSIONS_DIR=.sessions

# Historial de conversaciones (ledger JSON por conversación)
CONVERSATIONS_DIR=conversations

# Tamaño máximo de archivos subidos a /api/extract-file (bytes)
MAX_FILE_BYTES=20971520

# Observabilidad
EXPOSE_REASONING_CONTENT=true
WARMUP_ON_START=false
LOG_LEVEL=info
